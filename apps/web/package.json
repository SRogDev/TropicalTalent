{
  "name": "tropical-talent",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test": "bun test --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=999",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "prettier --write . && eslint . --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "migrate": "node migrations/apply.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:tenancy": "node scripts/verify-tenancy.mjs",
    "seed:tropical": "bun run scripts/seed-tropical.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "next": "16.0.10",
    "next-intl": "^4.15.0",
    "next-themes": "latest",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.20.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "1.3.3",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=999",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
