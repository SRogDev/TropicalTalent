# TropicalTalent — web app environment (reference build)
# Copy to .env.local and fill in. Empty placeholders only — no keys in this repo.
# Payments are omitted entirely in this build: there are no payment env vars.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, e.g. https://tropicaltalent.dev
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Postgres connection string for `bun run migrate`
TROPICAL_DB_URL=

# Dev seed password (dev databases only). Defaults to change-me-dev-only if unset.
TROPICAL_SEED_PASSWORD=
