# TropicalTalent AI — environment variables (placeholders only, no real values)
# Copy to .env and fill in with your own credentials. Never commit .env.

# Required
PINECONE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
INTERNAL_API_KEY=

# Optional
UPSTASH_REDIS_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# DEV ONLY — QSTASH_ALLOW_UNSIGNED=true lets /api/webhooks/vectorize accept
# unsigned deliveries when no QStash signing keys are configured (local dev
# without a QStash project). It has NO effect in production
# (SENTRY_ENVIRONMENT=production): unsigned requests are always rejected
# there. Without keys and without this flag, unsigned requests are rejected
# everywhere. Never set it to true in a deployed environment.
QSTASH_ALLOW_UNSIGNED=false
# Optional — Sentry error tracking. Leave SENTRY_DSN empty to disable Sentry
# entirely (local/dev default: no DSN -> SDK never initialised, no events sent).
# SENTRY_ENVIRONMENT defaults to "development" — set "staging"/"production"
# explicitly when deploying. Never put a real DSN in this file.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
PINECONE_INDEX_NAME=talent-index
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
